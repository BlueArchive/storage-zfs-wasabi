#
# Tests covering live pool RW->RO conversion (zpool set readonly=on),
# plus some related readonly import/export behavior.
#

[DEFAULT]
pre = setup
quiet = False
pre_user = root
user = root
timeout = 600
post_user = root
post = cleanup
failsafe_user = root
failsafe = callbacks/zfs_failsafe
tags = ['functional', 'readonly']

[tests/functional/cli_root/zpool_set]
tests = ['zpool_set_readonly_001_pos', 'zpool_set_readonly_002_pos',
    'zpool_set_readonly_003_pos', 'zpool_set_readonly_004_pos',
    'zpool_set_readonly_005_pos', 'zpool_set_readonly_006_pos',
    'zpool_set_readonly_007_pos', 'zpool_set_readonly_008_pos',
    'zpool_set_readonly_009_pos', 'zpool_set_readonly_010_pos',
    'zpool_set_readonly_011_pos', 'zpool_set_readonly_012_pos',
    'zpool_set_readonly_013_pos', 'zpool_set_readonly_014_pos',
    'zpool_set_readonly_015_pos', 'zpool_set_readonly_016_pos',
    'zpool_set_readonly_017_pos', 'zpool_set_readonly_018_pos',
    'zpool_set_readonly_019_pos',
    'zpool_set_readonly_001_neg', 'zpool_set_readonly_002_neg',
    'zpool_set_readonly_003_neg', 'zpool_set_readonly_004_neg',
    'zpool_set_readonly_005_neg', 'zpool_set_readonly_006_neg',
    'zpool_set_readonly_007_neg', 'zpool_set_readonly_008_neg']
tags = ['functional', 'cli_root', 'zpool_set', 'readonly']

[tests/functional/cli_root/zfs_set]
tests = ['readonly_001_pos']
tags = ['functional', 'cli_root', 'zfs_set', 'readonly']

[tests/functional/cli_root/zfs_mount]
tests = ['zfs_mount_remount']
tags = ['functional', 'cli_root', 'zfs_mount', 'readonly']

[tests/functional/cli_root/zfs_send]
tests = ['zfs_send_005_pos']
tags = ['functional', 'cli_root', 'zfs_send', 'readonly']

[tests/functional/rsend]
tests = ['rsend_014_pos']
tags = ['functional', 'rsend', 'readonly']

[tests/functional/upgrade]
tests = ['upgrade_readonly_pool']
tags = ['functional', 'upgrade', 'readonly']

[tests/functional/pool_checkpoint]
tests = ['checkpoint_ro_rewind']
tags = ['functional', 'pool_checkpoint', 'readonly']
